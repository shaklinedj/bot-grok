# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE TRADING CUANTITATIVO (v12)
# ==============================================================================

# Modo Operativo:
# - 'paper': Simulación hiper-realista con libro de órdenes, comisiones y slippage
# - 'live' : Ejecución con órdenes reales en el exchange seleccionado
TRADING_MODE=paper

# Exchange de Ejecución: 'pionex' | 'binance'
EXCHANGE=pionex

# ------------------------------------------------------------------------------
# CREDENCIALES PIONEX SPOT (https://www.pionex.com -> Gestión de API)
# Requiere permisos: "Trading" / "Lectura de balance"
# ------------------------------------------------------------------------------
PIONEX_API_KEY=tu_api_key_de_pionex_aqui
PIONEX_API_SECRET=tu_api_secret_de_pionex_aqui

# ------------------------------------------------------------------------------
# CREDENCIALES BINANCE SPOT (Opcional - si se opera en Binance)
# ------------------------------------------------------------------------------
BINANCE_API_KEY=tu_api_key_de_binance_aqui
BINANCE_API_SECRET=tu_api_secret_de_binance_aqui

# ------------------------------------------------------------------------------
# PARÁMETROS DE CAPITAL E INTERÉS COMPUESTO ESTRICTO
# ------------------------------------------------------------------------------
INITIAL_CAPITAL=80.0
MIN_ORDER_USDT=10.0
COMPOUND_INTEREST=true

# ------------------------------------------------------------------------------
# PUERTO DEL DASHBOARD INTERACTIVO EN VIVO
# ------------------------------------------------------------------------------
HTTP_PORT=8888
