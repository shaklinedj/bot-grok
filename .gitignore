# ==========================================
# Binance Spot Paper Trading Bot - Git Ignore
# ==========================================

# 1. Credenciales y Secretos (Seguridad Estricta)
.env
.env.*
!.env.example
*.key
*.pem

# 2. Archivos Temporales y Cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
ENV/

# 3. Logs de Ejecución y Estado Volátil en Tiempo Real
paper_logs/*
!paper_logs/.gitkeep
scalper_logs/*
!scalper_logs/.gitkeep
swing_logs/*
!swing_logs/.gitkeep
reversion_logs/*
!reversion_logs/.gitkeep
*.db
*.db-shm
*.db-wal
paper_logs_backup_*/
*.log
*.db-shm
*.db-wal
equity_chart.png

# 4. Archivos de Sistema Operativo e IDEs
.DS_Store
Thumbs.db
desktop.ini
NUL
.idea/
.vscode/
*.swp
*.swo
